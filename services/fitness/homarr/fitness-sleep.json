{
  "$schema": "homarr-custom-widget-v2",
  "id": "fitness-sleep",
  "name": "Last night sleep",
  "description": "Most recent sleep session and stages",
  "iconUrl": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@master/svg/garmin.svg",
  "url": "https://fitness.homelab.pratcode.dev/api/widgets/sleep",
  "authType": "apiKeyQuery",
  "headerName": "api_key",
  "method": "GET",
  "displayType": "keyValue",
  "displayConfig": {
    "type": "keyValue",
    "items": [
      { "label": "Date", "jsonPath": "$.date", "unit": "" },
      { "label": "Total", "jsonPath": "$.last_night_hours", "unit": "h" },
      { "label": "Light", "jsonPath": "$.light_hours", "unit": "h" },
      { "label": "Deep", "jsonPath": "$.deep_hours", "unit": "h" },
      { "label": "REM", "jsonPath": "$.rem_hours", "unit": "h" }
    ]
  }
}
