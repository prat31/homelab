{
  "$schema": "homarr-custom-widget-v2",
  "id": "fitness-overview",
  "name": "Fitness overview",
  "description": "Last 7 days of steps, distance, calories, sleep, workouts, RHR",
  "iconUrl": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@master/svg/garmin.svg",
  "url": "https://fitness.homelab.pratcode.dev/api/widgets/overview",
  "authType": "apiKeyQuery",
  "headerName": "api_key",
  "method": "GET",
  "displayType": "statGrid",
  "displayConfig": {
    "type": "statGrid",
    "items": [
      { "label": "Steps", "jsonPath": "$.steps", "unit": "" },
      { "label": "Distance", "jsonPath": "$.distance_km", "unit": "km" },
      { "label": "Calories", "jsonPath": "$.kcal", "unit": "kcal" },
      { "label": "Sleep", "jsonPath": "$.sleep_hours", "unit": "h" },
      { "label": "Workouts", "jsonPath": "$.workout_minutes", "unit": "min" },
      { "label": "RHR", "jsonPath": "$.rhr", "unit": "bpm" }
    ],
    "columns": 3
  }
}
