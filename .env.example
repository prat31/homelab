# ===========================================
# Homelab Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ALL configurable values go here.
# ===========================================

# ===========================================
# Domain Configuration
# ===========================================
DOMAIN_BASE=homelab.<user>.dev
# Public domain fronted by a Cloudflare Tunnel (cfargotunnel). Single-level
# subdomains hl-<service>.<PUBLIC_DOMAIN_BASE> are covered by Cloudflare's
# free Universal SSL cert (*.<PUBLIC_DOMAIN_BASE>), avoiding the need for ACM.
PUBLIC_DOMAIN_BASE=<user>.dev
PUBLIC_DOMAIN_PREFIX=hl-

# ===========================================
# Traefik Reverse Proxy
# ===========================================
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=your-email@example.com

# Cloudflare API credentials for DNS-01 challenge
CLOUDFLARE_EMAIL=your-cloudflare-email@example.com
CLOUDFLARE_DNS_API_TOKEN=your-cloudflare-dns-api-token

# Traefik dashboard basic auth (bcrypt or apr1 hash)
# Generate with: docker run --rm httpd:2-alpine htpasswd -nb admin yourpassword
# Note: Double any $ signs ($ -> $$) in the hash
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$REPLACE_WITH_GENERATED_HASH
# Alternative bcrypt: echo 'admin:yourpassword' | docker run --rm -i xmartlabs/htpasswd admin
# Then double the $ signs

# ===========================================
# PIA VPN (Gluetun)
# ===========================================
PIA_USERNAME=your-pia-username
PIA_PASSWORD=your-pia-password
PIA_REGION=Netherlands

# ===========================================
# Media Services
# ===========================================
PUID=1000
PGID=1000
TZ=Etc/UTC

# ===========================================
# Homarr Dashboard
# ===========================================
# Generate with: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=replace-with-generated-key

# ===========================================
# Uptime Kuma
# ===========================================
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=replace-with-generated-password
UPTIME_KUMA_API_KEY=replace-with-generated-api-key

# ===========================================
# Beszel Monitoring
# ===========================================
# Universal token for agent self-registration (created via hub API)
BESZEL_AGENT_TOKEN=replace-with-token-from-hub
# SSH public key from hub (extracted from data/beszel/id_ed25519)
BESZEL_AGENT_KEY=ssh-ed25519 replace-with-key-from-hub
# Constant system name shown in Beszel hub (prevents duplicate systems on each docker setup)
BESZEL_SYSTEM_NAME=Homelab

# ===========================================
# Immich
# ===========================================
IMMICH_VERSION=v3.0.3
DB_PASSWORD=replace-with-random-password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
UPLOAD_LOCATION=../../data/immich/library
DB_DATA_LOCATION=../../data/immich/postgres
DB_HOSTNAME=homelab-immich-postgres
REDIS_HOSTNAME=homelab-immich-redis
MACHINE_LEARNING_HOSTNAME=homelab-immich-ml

# ===========================================
# n8n
# ===========================================
N8N_ENCRYPTION_KEY=replace-with-generated-key
N8N_POSTGRES_PASSWORD=replace-with-password
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_DB=n8n

# ===========================================
# Kopia Backup
# ===========================================
# Web UI (kopia.${DOMAIN_BASE}) basic auth for the KopiaUI server
KOPIA_SERVER_USERNAME=admin
KOPIA_SERVER_PASSWORD=replace-with-generated-password
# Password used to encrypt the Kopia repository. KEEP THIS SAFE — losing it
# means losing access to all backups. Generate with: openssl rand -hex 32
KOPIA_REPOSITORY_PASSWORD=replace-with-generated-password
# Cloudflare R2 (S3-compatible) backend for the Kopia repository
# Bucket name you created in R2
KOPIA_R2_BUCKET=replace-with-bucket-name
# R2 S3 API endpoint, e.g. <accountid>.r2.cloudflarestorage.com (NO https://)
KOPIA_R2_ENDPOINT=replace-with-account-id.r2.cloudflarestorage.com
# R2 API token credentials (S3 Access Key ID / Secret Access Key)
KOPIA_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
KOPIA_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# ===========================================
# Jellyfin
# ===========================================
# Admin account for first-run setup (https://jellyfin.${DOMAIN_BASE})
JELLYFIN_ADMIN_USER=prat
JELLYFIN_ADMIN_PASSWORD=replace-with-strong-password
# API key used by Radarr/Sonarr to notify Jellyfin of new imports
JELLYFIN_API_KEY=replace-with-generated-key

# ===========================================
# Cloudflare Tunnel (cloudflared)
# ===========================================
# Token for the remotely-managed Cloudflare Tunnel used to publish
# *.${PUBLIC_DOMAIN_BASE} to the internet. Decoded at runtime into a
# credentials.json by the cloudflared-init container.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
# Cloudflare API token with "Cloudflare Tunnel: Edit" account permission.
# Used to publish per-service public hostnames on the tunnel so Cloudflare
# issues free per-hostname edge certificates (the free Universal SSL cert
# only covers *.pratcode.dev, not the second-level *.homelab-public.pratcode.dev).
CLOUDFLARE_TUNNEL_API_TOKEN=replace-with-cloudflare-tunnel-edit-api-token

# ===========================================
# Fitness (Health Connect)
# ===========================================
FITNESS_API_KEY=replace-with-generated-key
FITNESS_TZ=Asia/Kolkata
FITNESS_DRIVE_FOLDER_ID=replace-with-google-drive-folder-id
FITNESS_DRIVE_POLL_HOUR=6
# Desktop OAuth client from Google Cloud (Drive API enabled). Generate a
# refresh token with: docker compose run --rm fitness python -m app.oauth_setup
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional alternative to OAuth: paste service-account JSON (folder must be shared with the SA).
GOOGLE_SERVICE_ACCOUNT_JSON=
